.DS_Store
.venv/
__pycache__/
*.py[cod]

# Datasets are local inputs. They may be large or have redistribution limits.
data/*
!data/.gitkeep
!data/README.md
!data/own/
data/own/*
!data/own/.gitkeep

# Papers downloaded through the university's IEEE Xplore licence. Cite and link them.
docs/**/*.pdf

# Generated results and model binaries are recreated by the runner scripts.
outputs/*
!outputs/.gitkeep

# Packaged copies for sharing
dist/
